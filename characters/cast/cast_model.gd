## A main-cast character model (Tamlin, Lucien, Nesta, Elain, their father),
## generated by tools/blender/cast/build_cast.py on Feyre's rig.
##
## Everything Feyre's model does comes from feyre_model.gd: skin shader on the
## body surfaces, LOD1 hand-over, locomotion clips driven by the parent
## CharacterBody3D, hair swap, blend shapes and makeup.  On top of that a cast
## model wears its default outfit (glbs skinned to the same 60 bones, attached
## inside the instance's 180-degree turn like the hair), can slide claws out,
## and holds props on hand bones (the father's cane).
extends "res://characters/feyre/model/feyre_model.gd"

## Wardrobe glbs worn on spawn (characters/<id>/wardrobe/*.glb).
@export_file("*.glb") var outfit: PackedStringArray = []
## Unskinned prop glbs held on a bone: "res://...glb@LeftHand" or "...@LeftHand@tx,ty,tz,qx,qy,qz,qw"
## (the grip transform in bone space).
@export var held_props: PackedStringArray = []
## Clip that replaces "idle" / "walk" when present (e.g. the father's idle_cane, walk_limp).
@export var idle_clip: StringName = &""
@export var walk_clip: StringName = &""

var worn: Dictionary = {}   # path -> Node3D


func _ready() -> void:
	super._ready()
	for path in outfit:
		wear(path)
	for entry in held_props:
		var parts := entry.split("@")
		if parts.size() >= 2:
			var grip := Transform3D.IDENTITY
			if parts.size() == 3:
				var v := parts[2].split_floats(",")
				if v.size() == 7:
					grip = Transform3D(Basis(Quaternion(v[3], v[4], v[5], v[6])), Vector3(v[0], v[1], v[2]))
			hold(parts[0], parts[1], grip)
	if anim != null:
		_alias(idle_clip, &"idle")
		_alias(walk_clip, &"walk")
		if anim.has_animation(&"idle"):
			anim.play(&"idle")


## Puts on a garment or accessory glb skinned to this rig.  Wearing it again does nothing.
func wear(path: String) -> void:
	if worn.has(path) or skeleton == null or not ResourceLoader.exists(path):
		return
	var scene := load(path) as PackedScene
	if scene == null:
		return
	var inst := scene.instantiate()
	var holder := Node3D.new()
	holder.name = path.get_file().get_basename()
	skeleton.get_parent().add_child(holder)
	for mi in inst.find_children("*", "MeshInstance3D", true, false):
		var src := mi as MeshInstance3D
		var copy := MeshInstance3D.new()
		copy.name = src.name
		copy.mesh = src.mesh
		copy.skin = src.skin
		holder.add_child(copy)
		copy.skeleton = copy.get_path_to(skeleton)
	inst.free()
	worn[path] = holder


func take_off(path: String) -> void:
	if worn.has(path):
		(worn[path] as Node3D).queue_free()
		worn.erase(path)


## 0 = retracted, 1 = fully out (Tamlin's claws; the "Claws" mesh, blend shape claws_out).
func set_claws(amount: float) -> void:
	var claws := find_child("Claws", true, false) as MeshInstance3D
	if claws == null:
		return
	var idx := claws.find_blend_shape_by_name("claws_out")
	if idx >= 0:
		claws.set_blend_shape_value(idx, clampf(amount, 0.0, 1.0))


## Holds an unskinned prop glb on a bone (its origin is the grip).
func hold(path: String, bone: String, grip: Transform3D = Transform3D.IDENTITY) -> Node3D:
	if skeleton == null or not ResourceLoader.exists(path) or skeleton.find_bone(bone) < 0:
		return null
	var att := BoneAttachment3D.new()
	att.name = "Hold_" + path.get_file().get_basename()
	att.bone_name = bone
	skeleton.add_child(att)
	var inst := (load(path) as PackedScene).instantiate() as Node3D
	att.add_child(inst)
	inst.transform = grip
	return inst


func _alias(src: StringName, dst: StringName) -> void:
	if src == &"" or not anim.has_animation(src):
		return
	var lib := anim.get_animation_library(&"")
	if lib == null:
		return
	var a := anim.get_animation(src).duplicate() as Animation
	a.loop_mode = Animation.LOOP_LINEAR
	if lib.has_animation(dst):
		lib.remove_animation(dst)
	lib.add_animation(dst, a)
