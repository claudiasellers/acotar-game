## Feyre's rigged model (generated by tools/blender/feyre/build_feyre.py).
##
## Instances feyre.glb (turned to face -Z), puts the makeup skin shader on the
## body surfaces, wears a hairstyle glb from characters/feyre/hair/, plays her
## locomotion clips from the CharacterBody3D she belongs to, and exposes small
## helpers for expressions, the `nourished` body shape and makeup. Clothing
## glbs in characters/feyre/wardrobe/ share the same bone names; rebind them to
## `skeleton` to wear them.
extends Node3D

const BODY_SURFACES := ["torso", "arms", "legs", "feet", "hands"]
const HEAD_SURFACE := "head"
const MAKEUP_CHANNELS := ["lips", "eyeshadow", "liner", "blush", "brows", "face_paint"]
## Distance (m) where the full mesh hands over to Body_LOD1.
const LOD1_DISTANCE := 14.0
const LOOPING_CLIPS: Array[StringName] = [&"idle", &"idle_look", &"walk", &"run", &"sprint"]
## Ground speed (m/s) each gait clip was authored for (foot-locked at that speed).
const GAIT_SPEEDS := {&"walk": 3.2, &"run": 5.5, &"sprint": 8.0}
const MOVE_THRESHOLD := 0.25
const CLIP_BLEND := 0.2
## Seconds standing still before she glances around (idle_look plays once).
const LOOK_AFTER := 9.0

@export var skin_head_material: ShaderMaterial
@export var skin_body_material: ShaderMaterial
@export_file("*.glb") var hair_path: String = "res://characters/feyre/hair/braid.glb"

var skeleton: Skeleton3D
var body: MeshInstance3D
var hair: Node3D
var anim: AnimationPlayer
var _mover: CharacterBody3D
var _idle_time := 0.0
## The mocap AnimationTree (characters/feyre/movement/); null keeps the procedural clips.
var _animator: FeyreAnimator


func _ready() -> void:
	skeleton = find_child("Skeleton3D", true, false) as Skeleton3D
	body = find_child("Body", true, false) as MeshInstance3D
	var lod := find_child("Body_LOD1", true, false) as MeshInstance3D
	for mi: MeshInstance3D in [body, lod]:
		if mi != null:
			_apply_skin(mi)
	if body != null:
		body.visibility_range_end = LOD1_DISTANCE
	if lod != null:
		lod.visibility_range_begin = LOD1_DISTANCE
	set_hair(hair_path)
	anim = find_child("AnimationPlayer", true, false) as AnimationPlayer
	if anim != null:
		for clip in LOOPING_CLIPS:
			if anim.has_animation(clip):
				anim.get_animation(clip).loop_mode = Animation.LOOP_LINEAR
		if anim.has_animation(&"idle"):
			anim.play(&"idle")
	var n := get_parent()
	while n != null and not (n is CharacterBody3D):
		n = n.get_parent()
	_mover = n as CharacterBody3D
	if _mover != null:
		_animator = FeyreAnimator.attach(self, anim, _mover)


func _process(delta: float) -> void:
	if anim == null or _mover == null or _animator != null:
		return
	var v := _mover.velocity
	var speed := Vector2(v.x, v.z).length()
	play_locomotion(speed, _mover.is_on_floor(), delta)


## Picks idle / walk / run / sprint for a ground speed and scales the gait so feet don't skate.
func play_locomotion(speed: float, on_floor: bool, delta: float = 0.0) -> void:
	if anim == null:
		return
	var clip := &"idle"
	if speed > MOVE_THRESHOLD and on_floor:
		clip = &"walk"
		var gaits := _mover_gaits()
		if speed > (gaits[&"walk"] + gaits[&"run"]) * 0.5:
			clip = &"run"
		if speed > (gaits[&"run"] + gaits[&"sprint"]) * 0.5:
			clip = &"sprint"
	if clip == &"idle":
		_idle_time += delta
		if _idle_time > LOOK_AFTER and anim.has_animation(&"idle_look"):
			_idle_time = 0.0
			anim.play(&"idle_look", CLIP_BLEND)
			anim.queue(&"idle")
			return
		if anim.current_animation == &"idle_look":
			return
		anim.speed_scale = 1.0
	else:
		_idle_time = 0.0
		anim.speed_scale = clampf(speed / GAIT_SPEEDS[clip], 0.5, 1.6)
	if anim.current_animation != clip and anim.has_animation(clip):
		anim.play(clip, CLIP_BLEND)


## Ground speeds the gait is picked against: the mover's real walk/run/sprint when it
## has them (Feyre), else the speeds the clips were authored for.
func _mover_gaits() -> Dictionary:
	if _mover is Feyre:
		var f := _mover as Feyre
		return {&"walk": f.walk_speed, &"run": f.run_speed, &"sprint": f.sprint_speed}
	return GAIT_SPEEDS


## Plays a one-shot clip (e.g. "turn_left"), then returns to locomotion.
func play_once(clip: StringName) -> void:
	if anim != null and anim.has_animation(clip):
		anim.play(clip, CLIP_BLEND)
		anim.queue(&"idle")


## Swaps her hairstyle: `path` is a HairstyleData.mesh_path (skinned to the same bones).
func set_hair(path: String) -> void:
	if hair != null:
		hair.queue_free()
		hair = null
	if skeleton == null or path == "" or not ResourceLoader.exists(path):
		return
	var scene := load(path) as PackedScene
	if scene == null:
		return
	var inst := scene.instantiate()
	hair = Node3D.new()
	hair.name = "Hair"
	skeleton.get_parent().add_child(hair)
	for mi in inst.find_children("*", "MeshInstance3D", true, false):
		var src := mi as MeshInstance3D
		var copy := MeshInstance3D.new()
		copy.name = src.name
		copy.mesh = src.mesh
		copy.skin = src.skin
		hair.add_child(copy)
		copy.skeleton = copy.get_path_to(skeleton)
	inst.free()
	hair_path = path


func _apply_skin(mi: MeshInstance3D) -> void:
	for i in mi.mesh.get_surface_count():
		var surface_name := surface_name_of(mi.mesh, i)
		if surface_name == HEAD_SURFACE and skin_head_material != null:
			mi.set_surface_override_material(i, skin_head_material)
		elif surface_name in BODY_SURFACES and skin_body_material != null:
			mi.set_surface_override_material(i, skin_body_material)


static func surface_name_of(mesh: Mesh, index: int) -> String:
	var mat := mesh.surface_get_material(index)
	if mat != null and mat.resource_name != "":
		return mat.resource_name
	if mesh is ArrayMesh:
		return (mesh as ArrayMesh).surface_get_name(index)
	return ""


## Sets a blend shape (expression / viseme / "nourished") on the body.
func set_shape(shape_name: String, weight: float) -> void:
	if body == null:
		return
	var idx := body.find_blend_shape_by_name(shape_name)
	if idx >= 0:
		body.set_blend_shape_value(idx, clampf(weight, 0.0, 1.0))


## Hides body surfaces covered by clothing (e.g. ["torso", "arms"] for a tunic).
func set_surfaces_hidden(names: Array, hidden: bool) -> void:
	if body == null:
		return
	for i in body.mesh.get_surface_count():
		if surface_name_of(body.mesh, i) in names:
			body.set_surface_override_material(i, _invisible() if hidden else skin_body_material)


## channel: one of MAKEUP_CHANNELS.
func set_makeup(channel: String, color: Color, amount: float, sheen: float = -1.0) -> void:
	if skin_head_material == null or channel not in MAKEUP_CHANNELS:
		return
	skin_head_material.set_shader_parameter(channel + "_color", color)
	skin_head_material.set_shader_parameter(channel + "_amount", amount)
	if sheen >= 0.0:
		skin_head_material.set_shader_parameter(channel + "_sheen", sheen)


var _invisible_material: StandardMaterial3D


func _invisible() -> StandardMaterial3D:
	if _invisible_material == null:
		_invisible_material = StandardMaterial3D.new()
		_invisible_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		_invisible_material.albedo_color = Color(0, 0, 0, 0)
	return _invisible_material
