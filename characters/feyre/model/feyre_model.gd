## Feyre's rigged model (first pass, generated by tools/blender/feyre/build_feyre.py).
##
## Instances feyre.glb (turned to face -Z), puts the makeup skin shader on the
## body surfaces, and exposes small helpers for expressions, the `nourished`
## body shape and makeup. Clothing glbs in characters/feyre/wardrobe/ share
## the same bone names; rebind them to `skeleton` to wear them.
extends Node3D

const BODY_SURFACES := ["torso", "arms", "legs", "feet", "hands"]
const HEAD_SURFACE := "head"
const MAKEUP_CHANNELS := ["lips", "eyeshadow", "liner", "blush", "brows", "face_paint"]
## Distance (m) where the full mesh hands over to Body_LOD1.
const LOD1_DISTANCE := 14.0

@export var skin_head_material: ShaderMaterial
@export var skin_body_material: ShaderMaterial

var skeleton: Skeleton3D
var body: MeshInstance3D


func _ready() -> void:
	skeleton = find_child("Skeleton3D", true, false) as Skeleton3D
	body = find_child("Body", true, false) as MeshInstance3D
	var lod := find_child("Body_LOD1", true, false) as MeshInstance3D
	for mi: MeshInstance3D in [body, lod]:
		if mi != null:
			_apply_skin(mi)
	if body != null:
		body.visibility_range_end = LOD1_DISTANCE
	if lod != null:
		lod.visibility_range_begin = LOD1_DISTANCE


func _apply_skin(mi: MeshInstance3D) -> void:
	for i in mi.mesh.get_surface_count():
		var surface_name := surface_name_of(mi.mesh, i)
		if surface_name == HEAD_SURFACE and skin_head_material != null:
			mi.set_surface_override_material(i, skin_head_material)
		elif surface_name in BODY_SURFACES and skin_body_material != null:
			mi.set_surface_override_material(i, skin_body_material)


static func surface_name_of(mesh: Mesh, index: int) -> String:
	var mat := mesh.surface_get_material(index)
	if mat != null and mat.resource_name != "":
		return mat.resource_name
	if mesh is ArrayMesh:
		return (mesh as ArrayMesh).surface_get_name(index)
	return ""


## Sets a blend shape (expression / viseme / "nourished") on the body.
func set_shape(shape_name: String, weight: float) -> void:
	if body == null:
		return
	var idx := body.find_blend_shape_by_name(shape_name)
	if idx >= 0:
		body.set_blend_shape_value(idx, clampf(weight, 0.0, 1.0))


## Hides body surfaces covered by clothing (e.g. ["torso", "arms"] for a tunic).
func set_surfaces_hidden(names: Array, hidden: bool) -> void:
	if body == null:
		return
	for i in body.mesh.get_surface_count():
		if surface_name_of(body.mesh, i) in names:
			body.set_surface_override_material(i, _invisible() if hidden else skin_body_material)


## channel: one of MAKEUP_CHANNELS.
func set_makeup(channel: String, color: Color, amount: float, sheen: float = -1.0) -> void:
	if skin_head_material == null or channel not in MAKEUP_CHANNELS:
		return
	skin_head_material.set_shader_parameter(channel + "_color", color)
	skin_head_material.set_shader_parameter(channel + "_amount", amount)
	if sheen >= 0.0:
		skin_head_material.set_shader_parameter(channel + "_sheen", sheen)


var _invisible_material: StandardMaterial3D


func _invisible() -> StandardMaterial3D:
	if _invisible_material == null:
		_invisible_material = StandardMaterial3D.new()
		_invisible_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		_invisible_material.albedo_color = Color(0, 0, 0, 0)
	return _invisible_material
