## Tamlin's beast form (generated by tools/blender/cast/build_tamlin_beast.py).
##
## Instances tamlin_beast.glb turned to face -Z, marks the looping clips, plays
## `idle`, and hands the far view over to Body_LOD1 by visibility range.
## Clips: idle, prowl (1.48 m/s), run (8.6 m/s), snarl (once, ends held),
## snarl_hold (loop), roar (once). Gait clips are foot-locked at those ground
## speeds with no root motion: scale playback by actual_speed / authored speed.
extends Node3D

const LOOPING_CLIPS: Array[StringName] = [&"idle", &"prowl", &"run", &"snarl_hold"]
const GAIT_SPEEDS := {&"prowl": 1.48, &"run": 8.6}  # authored 1.2 / 7.0 m/s, scaled x1.23 with the model
## Distance (m) where the full mesh hands over to Body_LOD1.
const LOD1_DISTANCE := 18.0

@export var autoplay: StringName = &"idle"
@export var clip_blend := 0.25

var anim: AnimationPlayer
var skeleton: Skeleton3D


func _ready() -> void:
	anim = find_child("AnimationPlayer", true, false) as AnimationPlayer
	skeleton = find_child("Skeleton3D", true, false) as Skeleton3D
	if anim != null:
		for clip in LOOPING_CLIPS:
			if anim.has_animation(clip):
				anim.get_animation(clip).loop_mode = Animation.LOOP_LINEAR
		if autoplay != &"" and anim.has_animation(autoplay):
			anim.play(autoplay)
	var body := find_child("Body", true, false) as GeometryInstance3D
	var lod := find_child("Body_LOD1", true, false) as GeometryInstance3D
	if body != null and lod != null:
		body.visibility_range_end = LOD1_DISTANCE
		lod.visibility_range_begin = LOD1_DISTANCE


## Cross-fade to `clip`. For prowl/run pass the ground speed to keep paws planted.
func play(clip: StringName, ground_speed := -1.0) -> void:
	if anim == null or not anim.has_animation(clip):
		return
	var rate := 1.0
	if ground_speed > 0.0 and GAIT_SPEEDS.has(clip):
		rate = ground_speed / GAIT_SPEEDS[clip]
	anim.play(clip, clip_blend, rate)
