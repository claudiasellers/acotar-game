## Post-import script for tamlin_beast.glb (generated by
## tools/blender/cast/build_tamlin_beast.py). The generator bakes colour into
## COLOR_0; Godot's glTF importer does not turn on albedo-from-vertex-colour by
## itself, so do it here and give each surface its intended finish: matte fur,
## wet glossy mouth, waxy fangs, glossy black claws, glowing eyes.
@tool
extends EditorScenePostImport

const ROUGHNESS := {
	"beast_coat": 0.88,
	"beast_mouth": 0.22,
	"beast_gum": 0.18,
	"beast_tooth": 0.4,
	"beast_horn": 0.5,
	"beast_claw": 0.28,
	"beast_eye": 0.1,
}


func _post_import(scene: Node) -> Object:
	for n in scene.find_children("*", "MeshInstance3D", true, false):
		var mesh: Mesh = (n as MeshInstance3D).mesh
		if mesh == null:
			continue
		for s in mesh.get_surface_count():
			var mat := mesh.surface_get_material(s) as StandardMaterial3D
			if mat == null:
				continue
			var key := mat.resource_name
			if key == "beast_eye":
				# Iris texture drives albedo and emission (set by the glTF); keep it.
				mat.roughness = ROUGHNESS[key]
				continue
			if key == "beast_mouth" or key == "beast_gum":
				mat.roughness = ROUGHNESS[key]
				mat.metallic = 0.0
				continue
			mat.vertex_color_use_as_albedo = true
			mat.albedo_color = Color.WHITE
			mat.metallic = 0.0
			mat.roughness = ROUGHNESS.get(key, 0.85)
	return scene
