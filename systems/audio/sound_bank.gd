## Every sound cue in the game plus which bed and music play in each space.
## Generated by tools/audio/gen_act1_audio.py (R8: content as .tres).
class_name SoundBank
extends Resource

@export var cues: Array[SoundCue] = []
## Space id (a RegionDef id, or &"cottage_interior") -> ambience cue id.
@export var space_beds: Dictionary = {}
## Space id -> music cue id. Spaces left out play no music (the book keeps the
## Spring Court arrival silent).
@export var space_music: Dictionary = {}
## Space id -> footstep surface (&"snow", &"wood", &"grass", &"stone").
@export var space_surfaces: Dictionary = {}

var _by_id: Dictionary = {}


func cue(cue_id: StringName) -> SoundCue:
	if _by_id.size() != cues.size():
		_by_id.clear()
		for c: SoundCue in cues:
			_by_id[c.id] = c
	return _by_id.get(cue_id) as SoundCue


func has_cue(cue_id: StringName) -> bool:
	return cue(cue_id) != null
