## One spoken line or thought in free roam (lane L34). Lines are what people
## say to Feyre or what she thinks; she never picks a reply (R2: no dialogue
## choices, no objective text). A line reads WorldState and never writes a
## story flag: the only thing it records is that it was heard (`dlg.<id>`).
## Generated by tools/dialogue/gen_dialogue.py; edit the generator, not the .tres.
class_name DialogueLine
extends Resource

enum Trigger {
	ENTER_REGION,  ## Feyre walks into region `where`.
	ENTER_ROOM,    ## Feyre walks into manor-house room `where`.
	NEAR_PLACE,    ## Feyre comes within the radius of DialoguePlace `where`.
	NEAR_SPEAKER,  ## Feyre comes within talking range of the speaker (optionally only in `where`).
	DEED,          ## Flag `deed` rises (a deed she did); spoken once she is free again.
	FOLLOW_UP,     ## Only spoken right after the line that names it in `follow_up`.
	SCENE,         ## Spoken by a scene's guide at beat `where` ("<scene>.<beat>"), in book order.
}

@export var id: StringName
## Speaker key: a cast id (feyre, tamlin, lucien, alis, nesta, elain, father,
## mother), a CourtNpc npc_id, or a group key (villager, court_fae, servant,
## gardener, sentry, reveler).
@export var speaker: StringName = &"feyre"
## Name shown over the line; "" for Feyre's thoughts.
@export var who: String = ""
@export_multiline var text: String
## V verbatim from the book, A adapted, X invented in the book's voice.
@export var canon: String = "X"
@export var trigger: Trigger = Trigger.NEAR_SPEAKER
## Region id, manor room id or place id, by trigger. Empty: anywhere.
@export var where: StringName = &""
## DEED: the flag whose rising speaks this line.
@export var deed: StringName = &""
## Phase ids this line may play in. Empty: any phase.
@export var phases: PackedStringArray = []
@export var require_flags: PackedStringArray = []
@export var forbid_flags: PackedStringArray = []
## Clock hours [from, to) the line may play; from > to wraps midnight; -1 any.
@export var hour_from: float = -1.0
@export var hour_to: float = -1.0
## Once: heard a single time per save. Otherwise repeats after `cooldown` s.
@export var once: bool = true
@export var cooldown: float = 240.0
## Higher plays first when several fit.
@export var priority: int = 0
## A thought in her head (inner voice), not spoken aloud.
@export var inner: bool = false
## Line spoken right after this one (often Feyre's own answer, never a choice).
@export var follow_up: StringName = &""
## Note for voice casting (emotion and texture).
@export var delivery: String = ""
## Face preset while the line is said (lane L36's Faces.speak): neutral happy
## laugh smirk tender angry fury contempt disgust sad grief afraid terror
## surprise pained weary guarded pleading. Empty: neutral.
@export var emotion: StringName = &""


func heard_flag() -> String:
	return "dlg.%s" % id


## True when the hour fits [hour_from, hour_to).
func fits_hour(hour: float) -> bool:
	if hour_from < 0.0 or hour_to < 0.0:
		return true
	if hour_from <= hour_to:
		return hour >= hour_from and hour < hour_to
	return hour >= hour_from or hour < hour_to
