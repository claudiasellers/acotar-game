[gd_resource type="Resource" script_class="FaceProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/faces/face_profile.gd" id="1_face"]

[resource]
script = ExtResource("1_face")
character_id = &"wolf"
canon = "The human-realm forest wolves [C ch1-2]: a pack that stalks, flanks and circles, darting in. Our reading [X]: ears pinned and heads low with lips off the teeth while they ring her, the jaws gaping for each feint, silent and ears-forward while roaming."
