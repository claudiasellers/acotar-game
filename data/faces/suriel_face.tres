[ext_resource type="Script" path="res://systems/faces/face_profile.gd" id="1_face"]

[resource]
script = ExtResource("1_face")
character_id = &"suriel"
canon = "Thin as death, skin like old cloth, lipless mouth over too-many grey teeth [C ch14]. It smiles that lipless smile while it answers her, amused, and the teeth are horribly large [C ch14]; its milky eyes widen and it shrieks when it scents the naga [C ch14]. Never sad, never pleading."
