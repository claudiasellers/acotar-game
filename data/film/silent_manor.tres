[gd_resource type="Resource" script_class="FilmScript" load_steps=43 format=3]

[ext_resource type="Script" path="res://story/film/film_script.gd" id="1_script"]
[ext_resource type="Script" path="res://story/film/film_line.gd" id="2_line"]
[ext_resource type="Script" path="res://story/film/film_beat.gd" id="3_beat"]

[sub_resource type="Resource" id="L00"]
script = ExtResource("2_line")
id = &"c_01"
at = 13.0
hold = 3.5
speaker = &"alis"
text = "You can't be here. You were told to stay away."
canon = "C"

[sub_resource type="Resource" id="L01"]
script = ExtResource("2_line")
id = &"c_02"
at = 18.5
hold = 3.0
speaker = &"feyre"
text = "Where is he? What happened here?"
canon = "C"

[sub_resource type="Resource" id="L02"]
script = ExtResource("2_line")
id = &"c_03"
at = 22.0
hold = 3.6
speaker = &"alis"
text = "She took him. To her court, Under the Mountain."
canon = "C"

[sub_resource type="Resource" id="L03"]
script = ExtResource("2_line")
id = &"c_04"
at = 26.0
hold = 2.2
speaker = &"alis"
text = "Amarantha."
canon = "C"

[sub_resource type="Resource" id="L04"]
script = ExtResource("2_line")
id = &"c_05"
at = 29.0
hold = 4.8
speaker = &"alis"
text = "The seven times seven years are over. She is High Queen of Prythian now."
canon = "C"

[sub_resource type="Resource" id="L05"]
script = ExtResource("2_line")
id = &"c_06"
at = 34.3
hold = 4.4
speaker = &"alis"
text = "That I can tell you any of this means the game is over, to her."
canon = "C?"

[sub_resource type="Resource" id="L06"]
script = ExtResource("2_line")
id = &"c_07"
at = 40.5
hold = 10.0
speaker = &"alis"
text = "She came from across the sea, a commander in the old War. Forty-nine years ago, at a ball, she put a potion in the High Lords' wine and stole their powers. All seven of them."
canon = "C"

[sub_resource type="Resource" id="L07"]
script = ExtResource("2_line")
id = &"c_08"
at = 51.5
hold = 4.0
speaker = &"alis"
text = "For forty-nine years, we have been her slaves."
canon = "C"

[sub_resource type="Resource" id="L08"]
script = ExtResource("2_line")
id = &"c_09"
at = 56.5
hold = 5.0
speaker = &"alis"
text = "Tamlin would not be hers. He refused her and spat in her face."
canon = "C"

[sub_resource type="Resource" id="L09"]
script = ExtResource("2_line")
id = &"c_10"
at = 62.0
hold = 4.2
speaker = &"alis"
text = "So she cursed him, and all of us with him. The masks."
canon = "C"

[sub_resource type="Resource" id="L10"]
script = ExtResource("2_line")
id = &"c_11"
at = 66.5
hold = 4.4
speaker = &"alis"
text = "Then she bound us so we couldn't say a word about it. Not one word."
canon = "C"

[sub_resource type="Resource" id="L11"]
script = ExtResource("2_line")
id = &"c_12"
at = 72.0
hold = 8.0
speaker = &"alis"
text = "To break it, a human girl with ice in her heart, who hated our kind enough to kill one of his own, sent across the Wall."
canon = "C"

[sub_resource type="Resource" id="L12"]
script = ExtResource("2_line")
id = &"c_13"
at = 80.5
hold = 4.0
speaker = &"alis"
text = "And then she had to say she loved him, and mean it."
canon = "C"

[sub_resource type="Resource" id="L13"]
script = ExtResource("2_line")
id = &"c_14"
at = 85.0
hold = 5.5
speaker = &"alis"
text = "If no girl did, he would be her slave forever, and Prythian would stay under her rule."
canon = "C?"

[sub_resource type="Resource" id="L14"]
script = ExtResource("2_line")
id = &"c_15"
at = 91.5
hold = 4.5
speaker = &"alis"
text = "There was nothing in the Treaty about a life for a life. That was a lie."
canon = "C"

[sub_resource type="Resource" id="L15"]
script = ExtResource("2_line")
id = &"c_16"
at = 96.5
hold = 7.0
speaker = &"alis"
text = "The wolf you killed was one of us. Andras. Tamlin sent him across the Wall that day, knowing a girl like you might kill him."
canon = "C"

[sub_resource type="Resource" id="L16"]
script = ExtResource("2_line")
id = &"c_17"
at = 104.5
hold = 4.0
speaker = &"alis"
text = "You stupid, stupid girl. You never said it."
canon = "C"

[sub_resource type="Resource" id="L17"]
script = ExtResource("2_line")
id = &"c_18"
at = 109.0
hold = 5.5
speaker = &"alis"
text = "He had three days left when he sent you home. Three days, and he let you go."
canon = "C"

[sub_resource type="Resource" id="L18"]
script = ExtResource("2_line")
id = &"c_19"
at = 115.5
hold = 2.0
speaker = &"feyre"
text = "Where is he?"
canon = "C"

[sub_resource type="Resource" id="L19"]
script = ExtResource("2_line")
id = &"c_20"
at = 118.0
hold = 3.8
speaker = &"alis"
text = "Under the Mountain. With her. You'll die there."
canon = "C"

[sub_resource type="Resource" id="L20"]
script = ExtResource("2_line")
id = &"c_21"
at = 122.3
hold = 2.2
speaker = &"feyre"
text = "Then take me."
canon = "C"

[sub_resource type="Resource" id="L21"]
script = ExtResource("2_line")
id = &"c_22"
at = 128.0
hold = 2.6
speaker = &"alis"
text = "...Get your cloak."
canon = "C"

