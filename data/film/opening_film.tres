[gd_resource type="Resource" script_class="FilmScript" load_steps=54 format=3]

[ext_resource type="Script" path="res://story/film/film_script.gd" id="1_script"]
[ext_resource type="Script" path="res://story/film/film_line.gd" id="2_line"]
[ext_resource type="Script" path="res://story/film/film_beat.gd" id="3_beat"]

[sub_resource type="Resource" id="L00"]
script = ExtResource("2_line")
id = &"op_01"
at = 1.5
hold = 6.8
speaker = &""
text = "Every human child learns the story the same way. In lullabies. In rhymes we chant before we can read."
canon = "C"

[sub_resource type="Resource" id="L01"]
script = ExtResource("2_line")
id = &"op_02"
at = 11.0
hold = 7.5
speaker = &""
text = "Once, the whole of this land belonged to the faeries."
canon = "C"

[sub_resource type="Resource" id="L02"]
script = ExtResource("2_line")
id = &"op_03"
at = 21.0
hold = 10.0
speaker = &""
text = "The greatest of them, the High Fae, were ageless, and so beautiful it hurt to look at them. Stronger than us, faster than us, with magic in their blood."
canon = "C"

[sub_resource type="Resource" id="L03"]
script = ExtResource("2_line")
id = &"op_04"
at = 34.5
hold = 6.5
speaker = &""
text = "But not every faerie looked like a lord. Some wore the shapes of beasts."
canon = "C"

[sub_resource type="Resource" id="L04"]
script = ExtResource("2_line")
id = &"op_05"
at = 43.0
hold = 8.6
speaker = &""
text = "For thousands of years, we were their slaves. We built their cities with our blood and sweat, and raised temples to their savage gods."
canon = "C"

[sub_resource type="Resource" id="L05"]
script = ExtResource("2_line")
id = &"op_06"
at = 54.5
hold = 2.6
speaker = &""
text = "Until, at last, we rose against them."
canon = "C"

[sub_resource type="Resource" id="L06"]
script = ExtResource("2_line")
id = &"op_07"
at = 57.8
hold = 5.4
speaker = &""
text = "Then one of them turned traitor, and told us their secret. Ash wood can kill them."
canon = "A/X"

[sub_resource type="Resource" id="L07"]
script = ExtResource("2_line")
id = &"op_08"
at = 64.0
hold = 4.4
speaker = &""
text = "Still the killing went on, on both sides, until the ground was red."
canon = "A/X"

[sub_resource type="Resource" id="L08"]
script = ExtResource("2_line")
id = &"op_09"
at = 68.8
hold = 5.0
speaker = &""
text = "Six human queens signed a Treaty with them, five hundred years ago. A promise."
canon = "C"

[sub_resource type="Resource" id="L09"]
script = ExtResource("2_line")
id = &"op_10"
at = 75.7
hold = 9.8
speaker = &""
text = "The faeries kept the north, and took their magic with them. They called it Prythian. We were given the south, and a Wall between us that no one can see."
canon = "C"

[sub_resource type="Resource" id="L10"]
script = ExtResource("2_line")
id = &"op_11"
at = 86.5
hold = 10.2
speaker = &""
text = "The war was so terrible that no one could bear to speak of it. So we turned it into songs, as warnings for our children. Songs are all we know of them now."
canon = "A/X"

[sub_resource type="Resource" id="L11"]
script = ExtResource("2_line")
id = &"op_12"
at = 97.4
hold = 7.4
speaker = &""
text = "Five hundred years on, we still wear iron to keep them away. We tell our children that ash wood can kill them."
canon = "C"

[sub_resource type="Resource" id="L12"]
script = ExtResource("2_line")
id = &"op_13"
at = 107.0
hold = 6.5
speaker = &""
text = "My name is Feyre. I am nineteen, the youngest of three sisters."
canon = "C?"

[sub_resource type="Resource" id="L13"]
script = ExtResource("2_line")
id = &"op_14"
at = 125.0
hold = 8.4
speaker = &""
text = "When I was eight, my mother died. On her deathbed, she made me promise to keep our family together, and to look after them."
canon = "C"

[sub_resource type="Resource" id="L14"]
script = ExtResource("2_line")
id = &"op_15"
at = 133.8
hold = 7.0
speaker = &""
text = "She never lived to see us lose everything. My father was a merchant, and when she was alive, we were rich."
canon = "A"

[sub_resource type="Resource" id="L15"]
script = ExtResource("2_line")
id = &"op_16"
at = 141.0
hold = 8.4
speaker = &""
text = "Three years after she died, he spent every coin we had on three ships full of fine goods to sell. All three sank before they ever reached land."
canon = "A"

[sub_resource type="Resource" id="L16"]
script = ExtResource("2_line")
id = &"op_17"
at = 149.6
hold = 10.0
speaker = &""
text = "The men he owed money took our house, and we fled to a cottage in a poor village. One of them found us there anyway. His men smashed my father's knee. He has walked with a cane ever since."
canon = "A"

[sub_resource type="Resource" id="L17"]
script = ExtResource("2_line")
id = &"op_18"
at = 160.0
hold = 6.0
speaker = &""
text = "This winter is the worst yet. We are starving. My father can't hunt. My sisters won't."
canon = "C"

[sub_resource type="Resource" id="L18"]
script = ExtResource("2_line")
id = &"op_19"
at = 166.4
hold = 2.2
speaker = &""
text = "So I hunt."
canon = "C"

[sub_resource type="Resource" id="L19"]
script = ExtResource("2_line")
id = &"op_20"
at = 168.4
hold = 3.0
speaker = &""
text = "They say some of them are getting through the Wall now, into these woods. Out of Prythian."
canon = "C"

[sub_resource type="Resource" id="L20"]
script = ExtResource("2_line")
id = &"op_21"
at = 171.3
hold = 2.0
speaker = &""
text = "If I meet one, I'll kill it."
canon = "C"

