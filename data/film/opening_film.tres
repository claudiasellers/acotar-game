[gd_resource type="Resource" script_class="FilmScript" load_steps=49 format=3]

[ext_resource type="Script" path="res://story/film/film_script.gd" id="1_script"]
[ext_resource type="Script" path="res://story/film/film_line.gd" id="2_line"]
[ext_resource type="Script" path="res://story/film/film_beat.gd" id="3_beat"]

[sub_resource type="Resource" id="L00"]
script = ExtResource("2_line")
id = &"op_01"
at = 1.5
hold = 7.8
speaker = &""
text = "Every human child learns the story the same way. In lullabies. In rhymes we chant before we can read."
canon = "C"

[sub_resource type="Resource" id="L01"]
script = ExtResource("2_line")
id = &"op_02"
at = 11.0
hold = 7.5
speaker = &""
text = "Once, the whole of this land belonged to the faeries."
canon = "C"

[sub_resource type="Resource" id="L02"]
script = ExtResource("2_line")
id = &"op_03"
at = 21.0
hold = 11.0
speaker = &""
text = "The greatest of them, the High Fae, were ageless, and so beautiful it hurt to look at them. Stronger than us, faster than us, with magic in their blood."
canon = "C"

[sub_resource type="Resource" id="L03"]
script = ExtResource("2_line")
id = &"op_04"
at = 34.5
hold = 6.5
speaker = &""
text = "But not every faerie looked like a lord. Some wore the shapes of beasts."
canon = "C"

[sub_resource type="Resource" id="L04"]
script = ExtResource("2_line")
id = &"op_05"
at = 43.0
hold = 10.0
speaker = &""
text = "Once, we were their slaves. For thousands of years we built their cities with our blood and sweat, and their temples to gods we never knew."
canon = "C"

[sub_resource type="Resource" id="L05"]
script = ExtResource("2_line")
id = &"op_06"
at = 55.5
hold = 9.5
speaker = &""
text = "Once, we rose against them. The war was so terrible that we never told it plainly. We sang it to our children instead."
canon = "C"

[sub_resource type="Resource" id="L06"]
script = ExtResource("2_line")
id = &"op_07"
at = 69.0
hold = 8.0
speaker = &""
text = "Six human queens signed a Treaty with them, five hundred years ago. A promise."
canon = "C"

[sub_resource type="Resource" id="L07"]
script = ExtResource("2_line")
id = &"op_08"
at = 79.0
hold = 10.5
speaker = &""
text = "The faeries kept the north, and took their magic with them. They called it Prythian. We were given the south, and a Wall between us that no one can see."
canon = "C"

[sub_resource type="Resource" id="L08"]
script = ExtResource("2_line")
id = &"op_09"
at = 92.0
hold = 9.0
speaker = &""
text = "Five hundred years on, we still wear iron to keep them away. We still tell our children that ash wood can kill them."
canon = "C"

[sub_resource type="Resource" id="L09"]
script = ExtResource("2_line")
id = &"op_10"
at = 107.0
hold = 6.5
speaker = &""
text = "My name is Feyre. I am nineteen, the youngest of three sisters."
canon = "C?"

[sub_resource type="Resource" id="L10"]
script = ExtResource("2_line")
id = &"op_11"
at = 128.0
hold = 8.5
speaker = &""
text = "My mother died when I was eight. Before she did, she made me promise to keep us together, and to look after them."
canon = "C"

[sub_resource type="Resource" id="L11"]
script = ExtResource("2_line")
id = &"op_12"
at = 137.5
hold = 14.0
speaker = &""
text = "We were rich once. My father was a merchant. Three years after she died, he put every coin we had on three ships, and the sea took all three. The men he owed took everything else. Later, one of them found us here, and broke his leg."
canon = "C"

[sub_resource type="Resource" id="L12"]
script = ExtResource("2_line")
id = &"op_13"
at = 160.0
hold = 6.0
speaker = &""
text = "This winter is the worst yet. We are starving. My father can't hunt. My sisters won't."
canon = "C"

[sub_resource type="Resource" id="L13"]
script = ExtResource("2_line")
id = &"op_14"
at = 166.4
hold = 2.2
speaker = &""
text = "So I hunt."
canon = "C"

[sub_resource type="Resource" id="L14"]
script = ExtResource("2_line")
id = &"op_15"
at = 168.4
hold = 3.0
speaker = &""
text = "They say some of them are getting through the Wall now, into these woods. Out of Prythian."
canon = "C"

[sub_resource type="Resource" id="L15"]
script = ExtResource("2_line")
id = &"op_16"
at = 171.3
hold = 2.0
speaker = &""
text = "If I meet one, I'll kill it."
canon = "C"

