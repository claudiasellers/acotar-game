[sub_resource type="Resource" id="L00"]
script = ExtResource("2_line")
id = &"a_01"
at = 3.0
hold = 2.4
speaker = &"tamlin"
text = "It sings."
canon = "C"

[sub_resource type="Resource" id="L01"]
script = ExtResource("2_line")
id = &"a_02"
at = 5.6
hold = 3.2
speaker = &"feyre"
text = "And I suppose it knows drinking songs too."
canon = "C"

[sub_resource type="Resource" id="L02"]
script = ExtResource("2_line")
id = &"a_03"
at = 10.0
hold = 4.2
speaker = &"tamlin"
text = "You're human. Your senses are sealed off from all of it."
canon = "C?"

[sub_resource type="Resource" id="L03"]
script = ExtResource("2_line")
id = &"a_04"
at = 14.8
hold = 5.0
speaker = &"tamlin"
text = "I could open them. Let you see my world. Hear it, smell it. Taste it."
canon = "C?"

[sub_resource type="Resource" id="L04"]
script = ExtResource("2_line")
id = &"a_05"
at = 21.0
hold = 2.6
speaker = &"feyre"
text = "And what does it cost?"
canon = "C"

[sub_resource type="Resource" id="L05"]
script = ExtResource("2_line")
id = &"a_06"
at = 24.0
hold = 2.8
speaker = &"tamlin"
text = "Every gift comes with a price."
canon = "C"

[sub_resource type="Resource" id="L06"]
script = ExtResource("2_line")
id = &"a_07"
at = 27.3
hold = 1.8
speaker = &"tamlin"
text = "A kiss."
canon = "C"

[sub_resource type="Resource" id="L07"]
script = ExtResource("2_line")
id = &"a_08"
at = 29.6
hold = 1.8
speaker = &"feyre"
text = "...Fine."
canon = "C"

[sub_resource type="Resource" id="L08"]
script = ExtResource("2_line")
id = &"a_09"
at = 34.5
hold = 2.4
speaker = &"tamlin"
text = "Close your eyes."
canon = "C"

[sub_resource type="Resource" id="L09"]
script = ExtResource("2_line")
id = &"a_10"
at = 49.0
hold = 4.0
speaker = &"feyre"
text = "It smells of roses. Not metal any more."
canon = "C"

[sub_resource type="Resource" id="L10"]
script = ExtResource("2_line")
id = &"a_11"
at = 62.5
hold = 2.2
speaker = &"feyre"
text = "Why hide it?"
canon = "C"

[sub_resource type="Resource" id="L11"]
script = ExtResource("2_line")
id = &"a_12"
at = 65.0
hold = 2.4
speaker = &"tamlin"
text = "To look normal."
canon = "C?"

