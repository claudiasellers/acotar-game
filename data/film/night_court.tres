id = &"b_02"
at = 21.5
hold = 2.0
speaker = &"rhysand"
text = "High Lord."
canon = "C"

[sub_resource type="Resource" id="L02"]
script = ExtResource("2_line")
id = &"b_03"
at = 24.0
hold = 1.8
speaker = &"tamlin"
text = "Rhysand."
canon = "C"

[sub_resource type="Resource" id="L03"]
script = ExtResource("2_line")
id = &"b_04"
at = 26.2
hold = 4.5
speaker = &"rhysand"
text = "I don't see you for forty-nine years, and you start calling me Rhysand?"
canon = "C"

[sub_resource type="Resource" id="L04"]
script = ExtResource("2_line")
id = &"b_05"
at = 31.5
hold = 3.4
speaker = &"rhysand"
text = "A fox mask. Appropriate for you, Lucien."
canon = "C"

[sub_resource type="Resource" id="L05"]
script = ExtResource("2_line")
id = &"b_06"
at = 37.0
hold = 2.5
speaker = &"rhysand"
text = "Where's your guest?"
canon = "C"

[sub_resource type="Resource" id="L06"]
script = ExtResource("2_line")
id = &"b_07"
at = 41.5
hold = 2.5
speaker = &"rhysand"
text = "You dare glamour me?"
canon = "C"

[sub_resource type="Resource" id="L07"]
script = ExtResource("2_line")
id = &"b_08"
at = 48.5
hold = 3.2
speaker = &"rhysand"
text = "Let's see what's in that head of yours."
canon = "X"

[sub_resource type="Resource" id="L08"]
script = ExtResource("2_line")
id = &"b_09"
at = 53.3
hold = 3.5
speaker = &"tamlin"
text = "Please. Don't tell Amarantha about her."
canon = "C"

[sub_resource type="Resource" id="L09"]
script = ExtResource("2_line")
id = &"b_10"
at = 58.0
hold = 3.4
speaker = &"rhysand"
text = "Beg, and I'll consider not telling her."
canon = "C"

[sub_resource type="Resource" id="L10"]
script = ExtResource("2_line")
id = &"b_11"
at = 62.0
hold = 1.6
speaker = &"rhysand"
text = "Lower."
canon = "C"

[sub_resource type="Resource" id="L11"]
script = ExtResource("2_line")
id = &"b_12"
at = 64.0
hold = 2.0
speaker = &"rhysand"
text = "You too, fox-boy."
canon = "C"

[sub_resource type="Resource" id="L12"]
script = ExtResource("2_line")
id = &"b_13"
at = 68.5
hold = 2.4
speaker = &"rhysand"
text = "What's your name, love?"
canon = "C"

[sub_resource type="Resource" id="L13"]
script = ExtResource("2_line")
id = &"b_14"
at = 71.5
hold = 2.0
speaker = &"feyre"
text = "Clare Beddor."
canon = "C"

[sub_resource type="Resource" id="L14"]
script = ExtResource("2_line")
id = &"b_15"
at = 75.3
hold = 2.6
speaker = &"rhysand"
text = "Such a little liar."
canon = "X"

[sub_resource type="Resource" id="L15"]
script = ExtResource("2_line")
id = &"b_16"
at = 79.0
hold = 6.0
speaker = &"rhysand"
text = "I'm looking forward to seeing you three Under the Mountain. I'll give Amarantha your regards."
canon = "C"

[sub_resource type="Resource" id="L16"]
script = ExtResource("2_line")
