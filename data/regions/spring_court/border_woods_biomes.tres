[sub_resource type="Resource" id="b_spring_woodland"]
script = ExtResource("2_biome")
id = &"spring_woodland"
notes = "Mixed oak, beech and birch woodland, sun-dappled, flower-strewn. The default Border Woods."
ground_color = Color(0.42, 0.66, 0.32, 1)
ground_color_alt = Color(0.52, 0.72, 0.36, 1)
tree_density = 0.011
trees = {&"oak": 3.0, &"beech": 3.0, &"elm": 1.5, &"silver_birch": 2.0, &"hawthorn": 1.0, &"wild_cherry": 1.5, &"elder": 0.5}
shrub_density = 0.045
