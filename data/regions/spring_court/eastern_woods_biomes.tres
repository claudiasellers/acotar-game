[sub_resource type="Resource" id="b_deep_wood"]
script = ExtResource("2_biome")
id = &"deep_wood"
notes = "Old mixed woods east of the manor: tall, green-gold, deceptive (book: lush and dangerous)."
ground_color = Color(0.38, 0.6, 0.32, 1)
ground_color_alt = Color(0.32, 0.52, 0.3, 1)
tree_density = 0.013
trees = {&"oak": 3.0, &"beech": 3.0, &"elm": 1.5, &"ancient_oak": 0.6, &"silver_birch": 1.0, &"hawthorn": 0.5}
shrub_density = 0.05
shrubs = {&"fern": 4.0, &"bracken": 1.0, &"hazel": 1.0, &"mossy_rock": 1.5, &"fallen_log": 0.8, &"moss_mound": 1.5, &"root_arch": 0.4, &"foxglove": 0.4}
detail_density = 1.5
