forage_per_hectare = 18.0
forage = {&"ing_glowcap": 2.0, &"ing_hollow_root": 2.0, &"ing_oak_gall": 1.5, &"ing_wood_sorrel": 2.0, &"ing_hazelnut": 1.5, &"ing_moss": 1.5, &"ing_wild_hyacinth": 1.0, &"ing_owl_feather": 1.0, &"ing_honey": 0.5, &"ing_snail_shell": 1.0, &"col_acorn_caps": 1.5, &"col_jay_feather": 0.8, &"col_shed_antler": 0.4, &"col_odd_stone": 0.6}
