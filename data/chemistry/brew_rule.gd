## A named brew the chemistry engine recognises by what a result DOES, not by
## which ingredients went in (lane L62). Any forageables whose tags add up to
## the thresholds make it, so discovery stays emergent: a quiet steep is a
## Hush steep whether it came from lavender or hollow-root.
##
## Generated by tools/chemistry/gen_brews.py; never edit the .tres by hand.
class_name BrewRule
extends Resource

@export var id: StringName
@export var display_name: String
## Feyre's line on the discovery card and in the journal.
@export_multiline var note: String
## Any of these methods (roast, stew, infuse, cook, bake, preserve, distill,
## salve, steep, tincture).
@export var methods: Array[StringName] = []
## The result's kind must be this (food, tea, remedy, steep, poison,
## pigment), or any when empty.
@export var kind: StringName = &""
## Key -> minimum. Keys are effect tags (warm, quiet...) or the result's
## numbers: heal, harm, fae_toll, hunger_relief.
@export var need: Dictionary = {}
## Keys that must be zero or absent.
@export var forbid: Array[StringName] = []
## Higher wins when several rules match (a poison beats a tea).
@export var priority: int = 0
## The element it carries into the world (L59 ElementField): fire, water,
## wind or none.
@export var element: StringName = &""
## The colour of its sparkle and its swatch in the journal.
@export var color: Color = Color(1, 0.85, 0.95)
## A real combination that makes it, checked by the contract test:
## station id, then ingredient ids.
@export var witness_station: StringName
@export var witness: Array[StringName] = []
@export var canon: String = "X"


func matches(result: Dictionary) -> bool:
	if not result.get("ok", false):
		return false
	if not methods.is_empty() and not methods.has(StringName(result.get("method", &""))):
		return false
	if kind != &"" and StringName(result.get("kind", &"")) != kind:
		return false
	for key: Variant in need:
		if value_of(result, StringName(key)) < float(need[key]):
			return false
	for key in forbid:
		if value_of(result, key) > 0.001:
			return false
	return true


## The number a rule reads for `key`: an effect tag or a result field.
static func value_of(result: Dictionary, key: StringName) -> float:
	var effects: Dictionary = result.get("effects", {})
	if effects.has(key):
		return float(effects[key])
	if key in [&"heal", &"harm", &"fae_toll", &"hunger_relief"]:
		return float(result.get(String(key), 0.0))
	return 0.0
