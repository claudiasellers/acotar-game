[gd_resource type="Resource" script_class="SurielAnswer" format=3]

[ext_resource type="Script" path="res://story/act3/suriel/suriel_answer.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"suriel_blight"
order = 5
asked = "Where did the blight come from?"
said = "So the High Lord's human comes to trap a Suriel. Across the western sea lies Hybern, whose king sits on a throne of human bones and hates the Treaty. For fifty years he sent his commanders into the courts as spies and courtiers and lovers. Nearly five decades ago one of them disobeyed him. The Deceiver. And the sickness spread from what the Deceiver did."
said_cut = "So the High Lord's human comes to trap a Suriel. Across the western sea lies Hybern, whose king sits on a throne of human bones and hates the Treaty. For fifty years he sent his commanders into the courts as spies and courtiers and lovers. Nearly five decades ago one of them disobeyed him. The Deceiver. And—\n\nWe are not alone."
map_place = &""
canon = "C"
