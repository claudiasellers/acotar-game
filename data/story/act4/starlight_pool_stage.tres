"text": "Jump in.",
"who": "Tamlin"
},
"tamlin_lucien_1": {
"text": "Lucien is the youngest of seven brothers. His father is the High Lord of Autumn.",
"who": "Tamlin"
},
"tamlin_lucien_2": {
"text": "He loved a lesser faerie. His father had her executed, and made him watch.",
"who": "Tamlin"
},
