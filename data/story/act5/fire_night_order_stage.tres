"calanmai": {"text": "It's Calanmai. I have to go.", "who": "Tamlin"},
"drums": {"text": "Far off on the hills, the drums begin.", "who": ""},
"dusk": {"text": "Dying sunlight through the hall. He's bare to the waist but for the baldric.", "who": ""},
"lock": {"text": "Go to your chamber. Lock your doors, set up a snare, whatever you do.", "who": "Tamlin"},
