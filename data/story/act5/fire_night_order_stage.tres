invented = PackedStringArray("drums", "dusk")
canon = "Ch20 (Keeper 2026-11-02, [C]): Tamlin alone, at dusk in the hall, shirtless but for the baldric, armed. 'It's Calanmai... I have to go.' 'As a High Lord, I have to partake in the Great Rite.' 'Go to your chamber... Lock your doors, set up a snare, whatever you do.' Lucien isn't there. She locks herself in; by ten she follows the drums."
