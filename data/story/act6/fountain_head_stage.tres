lines = {
"crab_apple_thought": {"text": "His hands on my shoulders. I looked at a blossoming crab apple tree.", "who": ""},
"irises_thought": {"text": "I hauled my paints and easel out to paint one of the beds of irises.", "who": ""},
"lucien_brand": {"text": "They branded him behind the ear with a sigil... A mountain with three stars.", "who": "Lucien"},
"lucien_not_autumn": {"text": "Not Autumn Court... I don't recognize him at all.", "who": "Lucien"},
"no_mask": {"text": "No mask. So he wasn't a part of the Spring Court.", "who": ""},
"paints_thought": {"text": "He knelt and helped me pick up my paints.", "who": ""},
"something_wrong": {"text": "The birds had gone quiet.", "who": ""},
"tamlin_court_posturing": {"text": "Court posturing. Their lord's idea of a joke.", "who": "Tamlin"},
"tamlin_night_court": {"text": "Night Court.", "who": "Tamlin"},
"tamlin_still_safe": {"text": "You're still safe.", "who": "Tamlin"}
}
