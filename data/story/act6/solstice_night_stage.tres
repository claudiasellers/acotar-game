lines = {
"crowds_thought": {"text": "Faeries everywhere, and for the first time I saw them as they were.", "who": ""},
"follow_thought": {"text": "He led me from the fires to the edge of a vast meadow.", "who": ""},
"kiss_thought": {"text": "We danced, and he kissed me.", "who": ""},
"lucien_nursemaid": {"text": "Wonderful. And now I'm your nursemaid.", "who": "Lucien"},
"lucien_wine_warning": {"text": "Don't drink the wine. Not unless you want to dance until you drop.", "who": "Lucien"},
"sunrise_thought": {"text": "We watched the sun rise over the meadow.", "who": ""},
"tamlin_almost_dawn": {"text": "It's almost dawn.", "who": "Tamlin"},
"tamlin_come_away": {"text": "Come with me.", "who": "Tamlin"},
"wine_prompt": {"text": "Long tables of faerie wine and candied flowers. Tamlin was playing the fiddle with the band.", "who": ""},
"wine_thought": {"text": "It tasted of sunlight. The stars began to swim.", "who": ""},
"wisps_thought": {"text": "Will-o'-the-wisps, spirits of air and light, danced around us.", "who": ""}
}
