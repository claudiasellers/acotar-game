[ext_resource type="Script" path="res://story/framework/story_moment.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"attor"
chapters = "19"
anchor_id = &"attor_hiding_spot"
region_id = &"manor_grounds"
require_flags = PackedStringArray("first_painting")
