steps = Array[Dictionary]([{"do": "spawn", "actor": "high_fae_male", "at": Vector3(2.0, 0.0, -2.0), "face": Vector3(0.0, 0.0, 0.0)}, {"do": "spawn", "actor": "high_fae_male_2", "at": Vector3(-2.0, 0.0, -2.0), "face": Vector3(0.0, 0.0, 0.0)}, {"do": "spawn", "actor": "high_fae_male_3", "at": Vector3(0.0, 0.0, -3.0), "face": Vector3(0.0, 0.0, 0.0)}, {"do": "control", "mode": "NONE"}, {"do": "mood", "mood": "dread", "i": 0.9, "s": 0.8, "shake": 0.2}, {"do": "wait", "s": 4.0}, {"do": "spawn", "actor": "rhysand", "at": Vector3(0.0, 0.0, 2.0), "face": Vector3(0.0, 0.0, 0.0)}, {"do": "cue", "actor": "rhysand", "cue": "arm_around_her"}, {"do": "cue", "actor": "high_fae_male", "cue": "flee"}, {"do": "despawn", "actor": "high_fae_male"}, {"do": "despawn", "actor": "high_fae_male_2"}, {"do": "despawn", "actor": "high_fae_male_3"}, {"do": "mood", "mood": "dread", "i": 0.3, "s": 2.0, "shake": 0.0}, {"do": "control", "mode": "WALK"}, {"do": "interact", "n": 1, "r": 3.0}, {"do": "raise", "flag": "fact.stranger_stepped_away"}, {"do": "wait", "s": 2.0}, {"do": "raise", "flag": "stranger_met"}, {"do": "spawn", "actor": "lucien", "at": Vector3(3.0, 0.0, 3.0), "face": Vector3(0.0, 0.0, 0.0)}, {"do": "cue", "actor": "lucien", "cue": "carries_her_home"}])
notes = "L45: coded (story/act5/calanmai/cave_path.gd). Three faeries pin her; the stranger (Rhysand, unnamed) claims her as his; stepping out of his arm and walking away is her deed. Lucien carries her home."
