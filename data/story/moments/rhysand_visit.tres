[gd_resource type="Resource" script_class="StoryMoment" format=3]

[ext_resource type="Script" path="res://story/framework/story_moment.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"rhysand_visit"
chapters = "26"
anchor_id = &"manor_window_hide"
region_id = &"manor_house"
require_flags = PackedStringArray("solstice_danced", "fact.lunch_sat_down")
night_only = false
trigger = &"auto"
entry_radius = 3.0
steps = Array[Dictionary]([{"do": "film", "id": "night_court"}, {"do": "until_flag", "flag": "fact.film_night_court_seen"}, {"do": "mood", "mood": "dread", "i": 0.2, "s": 2.0, "shake": 0.0}, {"do": "raise", "flag": "rhysand_faced"}])
notes = "Starts when she sits down to lunch (L46 casts Tamlin and Lucien). Cutscene B (lane L33) plays it in the dining hall and brings Rhysand itself; the film writes fact.false_name_clare_beddor."
