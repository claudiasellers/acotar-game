[gd_resource type="Resource" script_class="StoryMoment" format=3]

[ext_resource type="Script" path="res://story/framework/story_moment.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"first_painting"
chapters = "19-20"
anchor_id = &"painting_room_easel"
region_id = &"manor_house"
require_flags = PackedStringArray("gallery_opened")
night_only = false
trigger = &"interact"
entry_radius = 2.5
steps = Array[Dictionary]([{"do": "until_flag", "flag": "first_painting"}, {"do": "raise", "flag": "first_painting"}, {"do": "celebrate", "kind": "painting"}])
notes = "L30: the studio (ui/studio) raises first_painting when her first canvas is finished."
