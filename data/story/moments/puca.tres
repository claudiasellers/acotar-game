[gd_resource type="Resource" script_class="StoryMoment" format=3]

[ext_resource type="Script" path="res://story/framework/story_moment.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"puca"
chapters = "10-11"
anchor_id = &"garden_gate"
region_id = &"manor_grounds"
require_flags = PackedStringArray("bogge_survived")
night_only = true
trigger = &"enter"
entry_radius = 5.0
steps = Array[Dictionary]([{"do": "spawn", "actor": "puca", "at": Vector3(0.0, 0.0, -10.0), "face": Vector3(0.0, 0.0, 0.0)}, {"do": "control", "mode": "WALK", "focus": "puca"}, {"do": "cue", "actor": "puca", "cue": "looks_like_father"}, {"do": "wait", "s": 2.0}, {"do": "spawn", "actor": "tamlin", "at": Vector3(2.0, 0.0, 1.0), "face": Vector3(0.0, 0.0, 0.0)}, {"do": "cue", "actor": "tamlin", "cue": "stops_her"}, {"do": "control", "mode": "LOOK", "focus": "puca"}, {"do": "cue", "actor": "puca", "cue": "shift_image"}, {"do": "mood", "mood": "dread", "i": 0.6, "s": 1.0, "shake": 0.0}, {"do": "wait", "s": 3.0}, {"do": "despawn", "actor": "puca"}, {"do": "raise", "flag": "puca_resisted"}])
notes = "She climbs down the trellis toward 'Father'; Tamlin stops her at the gate."
