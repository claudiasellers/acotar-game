"chair": {"text": "At the far end of the table, an empty chair slid out by itself.", "who": ""},
"eat": {"text": "Eat.", "who": "Tamlin"},
"eat_something": {"text": "You should eat something.", "who": "Tamlin"},
"follow_in": {"text": "He padded inside without looking back. I followed him in.", "who": ""},
