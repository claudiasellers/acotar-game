"alis_bath": {"text": "Come along, then. You'll want a bath.", "who": "Alis"},
"doors": {"text": "The doors swung open on silent hinges. A faint, metallic smell: magic.", "who": ""},
"first_rule": {"text": "Faerie food. The first rule: never eat their food.", "who": ""},
"lucien_andras": {"text": "So this is the girl who killed Andras.", "who": "Lucien"},
"sit_eat": {"text": "Sit. Eat.", "who": "Tamlin"},
