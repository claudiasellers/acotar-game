"alis_bath_drawn": {"text": "Your bath's drawn. In with you, and mind the hot water.", "who": "Alis"},
"alis_dinner": {"text": "Dinner. Don't keep him waiting.", "who": "Alis"},
"alis_dress": {"text": "I've laid out a dress for you.", "who": "Alis"},
"alis_tunic": {"text": "Trousers and a tunic, then. Your old things fell apart in the wash.", "who": "Alis"},
"bath_prompt": {"text": "Hot, scented water. More than I'd had in years.", "who": ""},
"bath_thought": {"text": "Alis scrubbed me raw and cut my hair. I sat in a white dressing gown.", "who": ""},
"feyre_no_dress": {"text": "I don't want the dress.", "who": "Feyre"},
