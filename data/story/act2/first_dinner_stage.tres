lines = {
"best_food": {"text": "The best food I had ever tasted.", "who": ""},
"feyre_dress": {"text": "I'd prefer not to wear that dress.", "who": "Feyre"},
"held": {"text": "Invisible hands clapped on my arms and shoved me back into the seat.", "who": ""},
"held_again": {"text": "The tang of magic. I couldn't get up until I'd eaten.", "who": ""},
"lucien_andras": {"text": "So. How does a scrawny human girl bring down a wolf like that?", "who": "Lucien"},
"lucien_tunic": {"text": "The tunic isn't as pretty as a dress.", "who": "Lucien"},
"no_slaves": {"text": "I don't keep slaves.", "who": "Tamlin"},
"sit": {"text": "Sit.", "who": "Tamlin"},
"sniff": {"text": "No metallic stench of magic. And faeries can't lie.", "who": ""},
"vanished": {"text": "I reached for another slice of torte, and the food vanished.", "who": ""}
}
