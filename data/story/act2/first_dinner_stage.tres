lines = {
"contemplating": {"text": "Do not do whatever it was you were contemplating.", "who": "Tamlin"},
"feyre_dress": {"text": "I'd prefer not to wear that dress.", "who": "Feyre"},
"first_rule": {"text": "Never eat their food. My hands stayed pinned under my thighs.", "who": ""},
"go_rest": {"text": "Go rest. Ask the staff for anything you need.", "who": "Tamlin"},
"held": {"text": "Invisible hands clapped on my arms and shoved me back into the seat. The tang of magic seared my nose.", "who": ""},
"laugh_growl": {"text": "Behind me, Lucien's barking laugh, cut off by a growl.", "who": ""},
"lucien_tunic": {"text": "The tunic isn't as pretty as a dress.", "who": "Lucien"},
"no_bite": {"text": "We're not going to bite.", "who": "Lucien"},
"no_slaves": {"text": "I don't keep slaves.", "who": "Tamlin"},
"not_enchanted": {"text": "The food is not enchanted, or drugged. You're going to sit at this table and eat, Feyre. And Lucien will do his best to be polite.", "who": "Tamlin"},
"sit": {"text": "Sit.", "who": "Tamlin"},
"sniff": {"text": "No metallic stench of magic. And faeries couldn't lie.", "who": ""},
"stay_for_wine": {"text": "Won't you stay for wine?", "who": "Lucien"},
"thanks": {"text": "Thank you for the meal.", "who": "Feyre"},
"vanished": {"text": "I reached for a second helping of torte, and the food vanished.", "who": ""}
}
