lines = {
"beast_sounds": {"text": "The scrape of claw, a huff of uneven breathing, the dripping of blood.", "who": ""},
"breeze": {"text": "A breeze. The glass garden doors stand open.", "who": ""},
"carry": {"text": "The water's red now. To the sink with it.", "who": ""},
"cuts": {"text": "A few vicious cuts. None of them need stitching.", "who": ""},
"drip": {"text": "His hand is bleeding. Drip, drip, onto the marble.", "who": ""},
"feyre_bogge": {"text": "Did you kill the Bogge?", "who": "Feyre"},
"feyre_hurt": {"text": "You're hurt.", "who": "Feyre"},
"feyre_where": {"text": "Where can we clean up your hand?", "who": "Feyre"},
"fill": {"text": "Water first. The deep sink at the back.", "who": ""},
"inferno": {"text": "The heat of his skin, like an inferno.", "who": ""},
"set_down": {"text": "Xs and circles. The doors, the windows, the marble stairs.", "who": ""},
"shift": {"text": "Between one step and the next, he changed forms. She squeezes her eyes shut at the blinding flash.", "who": ""},
"supplies": {"text": "Cabinets and drawers. A bowl, clean linen, a bandage.", "who": ""},
"tamlin_adept": {"text": "No wonder you became so adept at other things.", "who": "Tamlin"},
"tamlin_cant_write": {"text": "You can't write, can you.", "who": "Tamlin"},
"tamlin_infirmary": {"text": "There's a small infirmary.", "who": "Tamlin"},
"tamlin_yes": {"text": "Yes.", "who": "Tamlin"}
}
invented = PackedStringArray("breeze", "carry", "drip", "fill", "set_down", "supplies")
canon = "Ch12 (Keeper 2026-11-01, [C]): sleepless, she creeps barefoot down the moonlit stairs to the foyer, sets her little map on the foyer table and draws a few Xs and circles for the doors, the windows, the marble stairs. A breeze; he comes in through the open glass garden doors in beast form, eyes glowing, limping, dark shining stains on the marble; the beast fills the hall like a cage. Between one step and the next he changes forms (blinding flash, her eyes shut); fae, still and weary, no glow, clothes in shreds, only the hand bleeds. Lines as given. The infirmary: more of a supply closet with a worktable, cabinets, drawers, a deep sink at the back; she sorts supplies, cleans the blood and dirt in a bowl of water, binds and wraps his hand (a few vicious cuts, none needing stitches), carries the bowl of bloody water to the sink; he is silent, claws retracted. No salve in the book (dropped). Foyer table spot, route and props: X."
