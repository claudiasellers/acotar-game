## Feyre's map of the halls as data (ch12, L28): the five places she marks
## with an X or a circle, the little pictures she draws in rooms instead of
## names (she can't write), and the tower tops whose views she sketches onto
## the world map. Generated by tools/story/gen_house_beats.py.
class_name HallMapPlan
extends Resource

## One per hall_mark anchor, in order: {"n": 1, "shape": "x"|"o", "what": "the front doors", "thought": "..."}.
@export var marks: Array[Dictionary] = []
## Room id -> pictogram (book, bed, pot, harp, flower, star, cup, bath, brush,
## bow, crown, bandage, key, bottle, needle, candle). Rooms not listed get one
## from their id (HallMap.pictogram_for).
@export var pictograms: Dictionary = {}
## Tower-top room id -> map place ids she sketches from its windows.
@export var lookouts: Dictionary = {}
## Rooms on the page before the map counts as drawn (with all five marks).
@export var min_rooms: int = 12
## Mapping starts with this flag: the morning Alis trips her rope (owner,
## 2026-11-11; the book's ch12 map moved earlier) and runs beside the other
## beats until the map is drawn.
@export var start_flag: String = "fact.alis_tripped"
## Her thought the first time a room goes on her page: why she maps at all.
@export var first_thought: String = ""
@export_multiline var canon: String = ""
