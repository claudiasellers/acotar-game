magic = 0.0
; Already the horror grade: the woods dread mood would stack two stops
; more on top and turn the Bogge heart black.
dread_headroom = 0.0
; Dread through fog and desaturation, not darkness: low pooled fog
; hides the wood beyond ~60 m while the near ground and the Bogge read.
