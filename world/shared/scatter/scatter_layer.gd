## One kind of placed thing in a region: a forageable plant, a rock, a log, a
## collectible. Instances are generated by the region's generator script and
## committed (engineering rule R15). Five floats per instance, world coords:
## x, y, z, yaw (radians), scale.
class_name ScatterLayer
extends Resource

const STRIDE := 5
## The pickable model for an ingredient/keepsake id (tools/blender/forage/build_forage.py).
## When it exists it replaces the mesh of any layer carrying that ingredient_id,
## so what can be picked reads apart from the decor around it.
const FORAGE_MODELS := "res://art/forage/%s.glb"

static var _forage_models: Dictionary = {}

## Unique within the region. Forage keys are "<id>:<index>" (WorldDeltas).
@export var id: StringName
@export var mesh: Mesh
## Alternative to `mesh`: a .glb/.tscn (first MeshInstance3D's mesh is used)
## or a mesh .tres/.res. Lets generators reference assets that are made later.
@export_file("*.glb", "*.tscn", "*.tres", "*.res") var mesh_path: String
## Ingredient id from data/ingredients (lore ing_* ids). Empty = decoration.
@export var ingredient_id: StringName
## Free-form labels, e.g. "landmark", "collectible", "look".
@export var tags: PackedStringArray = []
@export var instances: PackedFloat32Array = []
@export var cast_shadow := true
## Drawn into the shadow maps only: a cheaper stand-in that casts for a layer
## which casts none itself.
@export var shadow_only := false
## Sway amount for the shared GPU wind (0 = rigid, e.g. rocks). Informational:
## set `wind_amount` on the layer's material (instance uniforms would overflow
## the global instance buffer with thousands of chunks).
@export_range(0.0, 1.0) var wind := 0.0
## Fully drawn up to this distance (metres).
@export var draw_distance := 120.0
## Where the mesh starts drawing (0: from the camera). A layer can stand in
## for another past it, so one tree has a near mesh to one distance and a
## lighter one beyond (the wider court's detail steps, finish plan T2/T6).
@export var draw_from := 0.0
## Optional camera-facing impostor drawn from draw_distance to impostor_distance.
## Optional material_override for every instance, usually a ShaderMaterial on
## world/shared/shaders/stylized_foliage.gdshader (default: the mesh's own).
@export var material: Material
@export var impostor_mesh: Mesh
@export_file("*.glb", "*.tscn", "*.tres", "*.res") var impostor_path: String
@export var impostor_distance := 600.0


func count() -> int:
	return instances.size() / STRIDE


func add(pos: Vector3, yaw: float, scale: float) -> int:
	instances.append_array(PackedFloat32Array([pos.x, pos.y, pos.z, yaw, scale]))
	return count() - 1


func position_of(index: int) -> Vector3:
	var o := index * STRIDE
	return Vector3(instances[o], instances[o + 1], instances[o + 2])


func transform_of(index: int) -> Transform3D:
	var o := index * STRIDE
	var s := instances[o + 4]
	var basis := Basis(Vector3.UP, instances[o + 3]).scaled(Vector3(s, s, s))
	return Transform3D(basis, position_of(index))


func is_forage() -> bool:
	return ingredient_id != &""


## The mesh the fields draw: the forage model for `ingredient_id` when there
## is one, else resolve_mesh().
func draw_mesh() -> Mesh:
	var model := forage_model(ingredient_id)
	return model if model != null else resolve_mesh()


## art/forage/<id>.glb's model mesh (cached), or null.
static func forage_model(item_id: StringName) -> Mesh:
	if item_id == &"":
		return null
	if not _forage_models.has(item_id):
		var path := FORAGE_MODELS % item_id
		_forage_models[item_id] = _load_mesh(path) if ResourceLoader.exists(path) else null
	return _forage_models[item_id]


## The mesh to draw: `mesh`, else loaded from `mesh_path`. Null if missing.
func resolve_mesh() -> Mesh:
	if mesh == null and mesh_path != "":
		mesh = _load_mesh(mesh_path)
	return mesh


func resolve_impostor() -> Mesh:
	if impostor_mesh == null and impostor_path != "":
		impostor_mesh = _load_mesh(impostor_path)
	return impostor_mesh


static func _load_mesh(path: String) -> Mesh:
	if not ResourceLoader.exists(path):
		push_warning("ScatterLayer: missing mesh %s" % path)
		return null
	var res := load(path)
	if res is Mesh:
		return res
	if res is PackedScene:
		var root: Node = (res as PackedScene).instantiate()
		var found: Mesh = null
		var nodes: Array[Node] = [root]
		nodes.append_array(root.find_children("*", "MeshInstance3D", true, false))
		for n in nodes:
			if n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
				found = (n as MeshInstance3D).mesh
				break
		root.free()
		return found
	return null
