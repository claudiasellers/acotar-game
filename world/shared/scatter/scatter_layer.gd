## One kind of placed thing in a region: a forageable plant, a rock, a log, a
## collectible. Instances are generated by the region's generator script and
## committed (engineering rule R15). Five floats per instance, world coords:
## x, y, z, yaw (radians), scale.
class_name ScatterLayer
extends Resource

const STRIDE := 5

## Unique within the region. Forage keys are "<id>:<index>" (WorldDeltas).
@export var id: StringName
@export var mesh: Mesh
## Ingredient id from data/ingredients (lore ing_* ids). Empty = decoration.
@export var ingredient_id: StringName
## Free-form labels, e.g. "landmark", "collectible", "look".
@export var tags: PackedStringArray = []
@export var instances: PackedFloat32Array = []
@export var cast_shadow := true
## Sway amount for the shared GPU wind (0 = rigid, e.g. rocks).
@export_range(0.0, 1.0) var wind := 0.0
## Fully drawn up to this distance (metres).
@export var draw_distance := 120.0
## Optional camera-facing impostor drawn from draw_distance to impostor_distance.
@export var impostor_mesh: Mesh
@export var impostor_distance := 600.0


func count() -> int:
	return instances.size() / STRIDE


func add(pos: Vector3, yaw: float, scale: float) -> int:
	instances.append_array(PackedFloat32Array([pos.x, pos.y, pos.z, yaw, scale]))
	return count() - 1


func position_of(index: int) -> Vector3:
	var o := index * STRIDE
	return Vector3(instances[o], instances[o + 1], instances[o + 2])


func transform_of(index: int) -> Transform3D:
	var o := index * STRIDE
	var s := instances[o + 4]
	var basis := Basis(Vector3.UP, instances[o + 3]).scaled(Vector3(s, s, s))
	return Transform3D(basis, position_of(index))


func is_forage() -> bool:
	return ingredient_id != &""
